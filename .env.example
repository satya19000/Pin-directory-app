NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Index only after importing a reviewed production dataset and setting your HTTPS domain.
ENABLE_INDEXING=false
NEXT_PUBLIC_ADS_MODE=placeholder
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=
NEXT_PUBLIC_AD_SLOT_CONTENT=
# For live bottom anchors use AdSense Auto ads > Anchor ads > Bottom only.
# Live ads load only after consent in the included preference panel.
# Optional reproducible production snapshot, downloaded only during build.
POSTAL_DATA_URL=
POSTAL_DATA_SHA256=
POSTAL_DATA_FORMAT=csv
POSTAL_SOURCE_NAME=
POSTAL_SOURCE_URL=
POSTAL_SOURCE_DATE=

# Fetch matching Wikipedia profiles and Commons credits for areas without curated guides.
AREA_DISCOVERY=on
